{
  "name": "@open-glass-ui/recipes",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Accessible, interactive React component recipes for OpenGlass UI.",
  "type": "module",
  "license": "MIT",
  "author": "Moe Luker",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react --external react-dom && cat src/styles.css src/liquid.css > dist/styles.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-glass-ui/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "react",
    "react-components",
    "liquid-glass",
    "glass-ui",
    "ui-library",
    "component-library",
    "design-system",
    "accessible",
    "typescript",
    "esm"
  ]
}
