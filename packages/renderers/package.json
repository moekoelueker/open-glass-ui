{
  "name": "@open-glass-ui/renderers",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "CSS, SVG, and opt-in WebGL rendering engines for OpenGlass UI.",
  "type": "module",
  "license": "MIT",
  "author": "Moe Luker",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js",
      "default": "./dist/webgl.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/webgl.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-glass-ui/core": "workspace:*"
  },
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "liquid-glass",
    "glass-ui",
    "refraction",
    "css",
    "svg",
    "webgl",
    "typescript",
    "esm"
  ]
}
