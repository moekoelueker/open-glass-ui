{
  "name": "open-glass-ui",
  "version": "0.3.0",
  "description": "Accessible Liquid Glass components, React primitives, and optical rendering utilities for the web.",
  "type": "module",
  "license": "MIT",
  "author": "Moe Luker",
  "homepage": "https://github.com/moekoelueker/open-glass-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moekoelueker/open-glass-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/moekoelueker/open-glass-ui/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js",
      "default": "./dist/webgl.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@open-glass-ui/core": "workspace:*",
    "@open-glass-ui/react": "workspace:*",
    "@open-glass-ui/recipes": "workspace:*",
    "@open-glass-ui/renderers": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "react-components",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "liquid-glass",
    "glass-ui",
    "glassmorphism",
    "refraction",
    "backdrop-filter",
    "webgl",
    "accessible",
    "typescript",
    "esm",
    "ssr"
  ]
}
